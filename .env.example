# =============================================================================
# Aura Local – Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores antes de iniciar a API.
# NUNCA comite o arquivo .env no repositório.
# =============================================================================

# Token de autenticação Bearer para a API.
# Requisitos: mínimo 32 caracteres ASCII, sem espaços.
# Gere um token seguro com: python -c "import secrets; print(secrets.token_hex(32))"
AURA_API_TOKEN=seu_token_super_secreto_com_no_minimo_32_chars

# Modelo Ollama a ser utilizado para inferência local.
# Deve corresponder a um modelo já baixado no Ollama (ex: ollama pull llama3).
# Modelos cloud não são permitidos.
# Padrão: llama3
AURA_MODEL=llama3

# =============================================================================
# Configurações do Agente (opcionais — desabilitadas por padrão)
# =============================================================================

# Habilita as rotas de agente (/api/agent) com tool calling e memória de sessão.
# Padrão: false
# AURA_AGENT_ENABLED=true

# Diretório base para a ferramenta read_file. O agente só pode ler arquivos
# dentro deste diretório (proteção contra path traversal).
# Obrigatório para habilitar read_file. Deixe em branco para desabilitar.
# AURA_WORKSPACE_DIR=C:\Users\seu_usuario\projetos\meu_workspace

# Lista de comandos shell permitidos para a ferramenta run_shell (separados por vírgula).
# Deixe em branco para desabilitar run_shell completamente.
# Exemplo: AURA_ALLOWED_COMMANDS=ls,cat,echo,pwd,dir,type
# AURA_ALLOWED_COMMANDS=ls,cat,echo

# Tempo de vida das sessões in-memory em minutos (1–1440). Padrão: 30.
# AURA_SESSION_TTL_MINUTES=30

# Número máximo de iterações do loop agentic por requisição (1–20). Padrão: 5.
# AURA_MAX_AGENT_LOOPS=5
