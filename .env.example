# =============================================================================
# Aura Local – Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores antes de iniciar a API.
# NUNCA comite o arquivo .env no repositório.
# =============================================================================

# Token de autenticação Bearer para a API.
# Requisitos: mínimo 32 caracteres ASCII, sem espaços.
# Gere um token seguro com: python -c "import secrets; print(secrets.token_hex(32))"
AURA_API_TOKEN=seu_token_super_secreto_com_no_minimo_32_chars

# Modelo Ollama a ser utilizado para inferência local.
# Deve corresponder a um modelo já baixado no Ollama (ex: ollama pull llama3).
# Modelos cloud não são permitidos.
# Padrão: llama3
AURA_MODEL=llama3
